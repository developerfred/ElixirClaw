# ElixirClaw Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control!

# ===========================================
# Node Configuration
# ===========================================

# Gateway connection settings
ELIXIR_CLAW_HOST=127.0.0.1
ELIXIR_CLAW_PORT=18789
ELIXIR_CLAW_NODE_ID=node_your_node_id_here
ELIXIR_CLAW_DISPLAY_NAME="My ElixirClaw Node"
ELIXIR_CLAW_TOKEN=your_auth_token_here
ELIXIR_CLAW_DEVICE_ID=device_your_device_id_here
ELIXIR_CLAW_CLIENT_ID=elixir_claw

# ===========================================
# LLM Integration - Choose your provider
# ===========================================

# Set your preferred LLM provider: claude, openai, nvidia, openrouter, opencode
ELIXIR_CLAW_LLM_PROVIDER=claude

# Optional: Set a specific model
# ELIXIR_CLAW_LLM_MODEL=meta/llama-3.1-8b-instruct

# ===========================================
# LLM Provider API Keys
# ===========================================

# Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT-4 (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenCode (https://opencode.ai/)
OPENCODE_API_KEY=your_opencode_api_key_here

# OpenCode base URL (optional, for self-hosted instances)
# OPENCODE_BASE_URL=https://api.opencode.ai/v1

# ===========================================
# Dashboard Configuration
# ===========================================

# Enable Phoenix LiveView dashboard on startup
ELIXIR_CLAW_START_DASHBOARD=false

# Dashboard port (default: 4000)
# PHOENIX_PORT=4000

# ===========================================
# Logging
# ===========================================

# Log level: debug, info, warning, error
ELIXIR_CLAW_LOG_LEVEL=info

# ===========================================
# Security Notes
# ===========================================

# 1. NEVER commit this file with real API keys to version control
# 2. Use environment variables in production (Kubernetes secrets, AWS Secrets Manager, etc.)
# 3. Rotate API keys regularly
# 4. Restrict capabilities in production: only allow what's needed
# 5. Use allowlisting for system.run commands

# Example production config:
# ELIXIR_CLAW_LLM_PROVIDER=nvidia
# NVIDIA_API_KEY=nvapi-xxxxx
# ELIXIR_CLAW_START_DASHBOARD=false
